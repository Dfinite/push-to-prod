# ai-service 환경변수 — 복사해서 사용: cp .env.example .env
# .env 는 .gitignore 처리됨 (커밋 금지)

# Claude API 키 (필수) — intake.extract / gen_questions / gen_ontology tool-calling 에 사용
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 Claude 모델 (선택)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 레퍼런스 Postgres DB (retrieve.load_reference 가 introspect) — 키워드 DSN 형식.
# 예) host=<host> port=<port> user=<user> password=<pw> dbname=<db>
REFERENCE_DATABASE_URL=host=localhost port=5432 user=postgres password=postgres dbname=tpch
# 또는 개별 변수로: REFERENCE_DB_HOST / REFERENCE_DB_PORT / REFERENCE_DB_USER /
#                   REFERENCE_DB_PASSWORD / REFERENCE_DB_NAME
